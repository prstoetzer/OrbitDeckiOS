<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<!-- A satellite pass runs 8-15 minutes, and the operator routinely locks the screen
             or switches apps partway through it. The app must keep recording and playing
             audio for the whole pass:
               - Pass recording captures the radio's received audio to an AAC file
                 (Recording/PassRecorder.swift).
               - SSTV and FT4 decode the received audio continuously; FT4 also synthesizes
                 and plays transmit audio out to the radio (Audio/USBAudioSource.swift).
               - Remote voice streams the radio's received audio to the device speaker
                 (Audio/AudioHub.swift).
             Interrupting any of these loses the pass - the satellite is gone and won't be
             back for ~90 minutes. -->
		<string>audio</string>
		<!-- Background app refresh keeps the next-pass Live Activity current while the
             app is closed (LiveActivityController, BGAppRefreshTask). -->
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.prstoetzer.OrbitDeckIOS.liveActivityRefresh</string>
	</array>
	<!-- Notes (Tools → Notes) are plain .txt files in Documents/Notes; these two keys
         make the Documents folder browsable and editable in the Files app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
